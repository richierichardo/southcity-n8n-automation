# n8n self-hosted configuration example
# Copy this file to .env on the VPS and replace every placeholder.

N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_PORT=5678

# Use a long random value. Never commit the real value.
N8N_ENCRYPTION_KEY=replace_with_a_long_random_secret

# Public editor and webhook URLs behind the reverse proxy.
N8N_EDITOR_BASE_URL=https://n8n.example.com/
WEBHOOK_URL=https://n8n.example.com/

# Recommended security settings for HTTPS deployment.
N8N_SECURE_COOKIE=true

# Allow file nodes to access only the mounted input directory.
N8N_RESTRICT_FILE_ACCESS_TO=/files

# The DeepSeek key and Google OAuth secrets are configured in n8n Credentials.
# They must not be placed in this file or committed to Git.
